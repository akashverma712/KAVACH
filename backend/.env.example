# ─────────────────────────────────────────────────────────────
#  Kavach backend configuration
#  Copy this file to .env  (cp .env.example .env)
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000

# Comma-separated list of allowed browser origins (student + admin apps)
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,http://localhost:4174,http://localhost:8080,http://localhost:8081

# Set to 1 when running behind a reverse proxy (nginx / docker "full" profile / cloud LB)
TRUST_PROXY=0

# ── Database (matches docker-compose.yml defaults) ───────────
DATABASE_URL=postgres://kavach:kavach_dev_password@localhost:5432/kavach
DB_POOL_MAX=20
DB_SSL=false

# ── Security ─────────────────────────────────────────────────
# Use long random strings in production:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-student-jwt-secret-use-a-long-random-string
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-use-a-different-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# ── College rules ────────────────────────────────────────────
ALLOWED_EMAIL_DOMAIN=bitsindri.ac.in
DEFAULT_COUNTRY_CODE=+91

# ── Admin (seeded on first start) ────────────────────────────
ADMIN_EMAIL=rockingav9876@gmail.com
ADMIN_NAME=Campus Admin
ADMIN_PHONE=7479676602

# ── OTP ──────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# ── SOS ──────────────────────────────────────────────────────
SOS_MAX_PER_HOUR=10

# ── Community ────────────────────────────────────────────────
AUTO_HIDE_REPORT_THRESHOLD=5

# ── Email (SMTP) ─────────────────────────────────────────────
# Leave SMTP_HOST / SMTP_USER / SMTP_PASS empty → OTPs & alerts are printed in this terminal.
# Fill them in → emails are sent for real. No code change needed (nodemon restarts on .env save).
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=you@gmail.com SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kavach BIT Sindri <no-reply@bitsindri.ac.in>"

# ── SMS (Twilio) ─────────────────────────────────────────────
# Leave empty → SMS (OTP + SOS) are printed in this terminal.
# Fill all three → real SMS via Twilio. No code change needed.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Optional: AI answers for the campus chatbot ──────────────
# Without a key the chatbot answers from the admin-managed knowledge base (full-text search).
ANTHROPIC_API_KEY=
CHATBOT_MODEL=claude-haiku-5-5

# ── Uploads ──────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
